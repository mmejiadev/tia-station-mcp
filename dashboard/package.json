{
  "name": "tia-station-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Reads the harness API and shows what the loop measured, what was changed, and whether the workshop gate is open.",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
