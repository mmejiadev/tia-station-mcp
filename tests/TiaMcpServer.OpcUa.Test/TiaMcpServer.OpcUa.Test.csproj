<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <BaseOutputPath>.\bin</BaseOutputPath>
  </PropertyGroup>

  <!--
    The OPC UA client's tests, and they need neither TIA Portal nor a PLC.

    The server they read from is started in the test process, from the OPC Foundation's own server
    stack: a secured endpoint, a self-signed certificate, and a handful of variables named the way
    a Siemens CPU names them. That makes the certificate pin testable for real, not only as a
    unit: a second server started with a new certificate on the same port is the "CPU was
    swapped" case, and it has to be refused over an actual secured channel.

    Same rule as the governance tests: this project references TiaMcpServer.OpcUa and, through it,
    TiaMcpServer.Portable, and never TiaMcpServer. That keeps it buildable on a CI runner.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);IDE0008</NoWarn>  <!-- var: CLAUDE.md asks for judgement the analyzer cannot make -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>   <!-- constant arrays as arguments: a hot-path concern, in test setup -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest" Version="3.9.2" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Server" Version="1.5.378.176" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TiaMcpServer.OpcUa\TiaMcpServer.OpcUa.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
</Project>
