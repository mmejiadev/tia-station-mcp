<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <BaseOutputPath>.\bin</BaseOutputPath>
  </PropertyGroup>

  <!--
    Inherited-test debt ledger. Same rules as src/TiaMcpServer/TiaMcpServer.csproj: this list
    is meant to shrink, and nothing we write ourselves should need adding to it.

    CA1001 and CA2000 used to be here, suppressed because every inherited test class held its own
    Portal field and never disposed it. Reviving those classes removed the last of them: the one
    portal for the run is owned by AssemblyHooks. The two rules are armed again and the entries
    are gone, which is what shrinking this list looks like.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);IDE0008</NoWarn>                    <!-- use explicit type instead of var -->
    <NoWarn>$(NoWarn);CA1805</NoWarn>                     <!-- explicit default initialisation -->
    <NoWarn>$(NoWarn);IDE0044;IDE0031;IDE0005;IDE0051</NoWarn> <!-- style / dead code -->
    <NoWarn>$(NoWarn);CA1508;CA1852;CA1052;CA1812</NoWarn> <!-- type shape nits -->
    <NoWarn>$(NoWarn);CA1307;CA1309</NoWarn>              <!-- string comparison -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest" Version="3.9.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TiaMcpServer\TiaMcpServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the sample archive next to the test assembly so tests can locate it without
         absolute paths that only exist on one machine. -->
    <None Update="assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
