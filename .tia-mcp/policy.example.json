// Copy this file to .tia-mcp/policy.json and edit it. Without policy.json every write is refused,
// which is deliberate: the absence of a decision is a refusal, never a permission.
//
// Targets come in five families:
//   PLC_0/Blocks/FB_Station   a place in the project tree
//   simulation/Station_1      a PLCSIM Advanced virtual controller
//   simulation-runtime        the PLCSIM Advanced runtime itself, machine-wide
//   project                   the project as a whole: save, save-as, close
//   opcua/192.168.0.1:4840    an OPC UA server this session may READ from; nothing is written
//
// Note that 'simulation/*' does NOT cover 'simulation-runtime', and that is the intent: one
// controller affects itself, the runtime's network mode affects every PLCSIM user on the machine.
//
// '*' stands for any run of characters. It is not a regular expression. Deny beats allow, and a
// target matching neither list is refused. Workshop rules may not contain wildcards at all: every
// target that can move a machine is written out in full, or the policy is refused when it loads.
{
  "study": {
    "allow": [
      "PLC_0",
      "PLC_0/*",
      "simulation/*",
      "project"

      // Uncomment to let ReadOpcUaValues and BrowseOpcUaServer reach the PLCSIM controller the
      // harness creates. Reading changes nothing, but it is still contact with a machine.
      // "opcua/192.168.0.1:4840"
    ],
    "deny": [
      // Safety code is written by a person, reviewed by a person, and not by an agent.
      "PLC_0/Safety/*"
    ]
  },

  "workshop": {
    "allow": [
      "PLC_0/Blocks/FB_Station"
    ],
    "deny": []
  }
}
