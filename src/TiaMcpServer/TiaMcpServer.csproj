<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <OutputType>Exe</OutputType>
    <AssemblyVersion>0.0.18</AssemblyVersion>
    <BaseOutputPath>.\bin</BaseOutputPath>
  </PropertyGroup>

  <!--
    Inherited-code debt ledger.

    Directory.Build.props turns every warning into an error. The code forked from
    heilingbrunner/tiaportal-mcp predates those rules and trips ~950 of them, so building it
    at full strictness is impossible today. Rather than switch the strictness off, each
    diagnostic is suppressed here explicitly and tracked in docs/STATUS.md.

    This list is meant to SHRINK. When an area is cleaned up, delete its code from here so the
    analyzer starts guarding it again. Do not add to the list for code we write ourselves.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1591</NoWarn>          <!-- missing XML doc on public members: 424 -->
    <NoWarn>$(NoWarn);IDE0008</NoWarn>         <!-- use explicit type instead of var: 216 -->
    <NoWarn>$(NoWarn);CA2254</NoWarn>          <!-- logging template is not a static expression: 94 -->
    <NoWarn>$(NoWarn);CA1062</NoWarn>          <!-- validate arguments of public methods: 56 -->
    <NoWarn>$(NoWarn);IDE0011</NoWarn>         <!-- add braces to single-line statements: 36 -->
    <NoWarn>$(NoWarn);CA1508</NoWarn>          <!-- avoid dead conditional code: 22 -->
    <NoWarn>$(NoWarn);CA1829</NoWarn>          <!-- use Length/Count instead of Count(): 18 -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>          <!-- member can be static: 14 -->
    <NoWarn>$(NoWarn);CA1002</NoWarn>          <!-- do not expose List&lt;T&gt;: 12 -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>          <!-- constant arrays as arguments: 10 -->
    <NoWarn>$(NoWarn);CA1307;CA1309;CA1311;CA1308</NoWarn> <!-- string comparison / casing: 28 -->
    <NoWarn>$(NoWarn);CA1860</NoWarn>          <!-- prefer Count over Any(): 8 -->
    <NoWarn>$(NoWarn);CA1032;CA1052;CA1724;CA1711;CA2227;CA1024;IDE0270</NoWarn> <!-- API shape nits: 26 -->
  </PropertyGroup>

  <!--
    Everything that does not touch Siemens.Engineering lives in TiaMcpServer.Portable, so that it
    builds and its tests run on a machine with no TIA Portal. The dependency goes this way and only
    this way: that project must never reference this one.
  -->
  <ItemGroup>
    <ProjectReference Include="..\TiaMcpServer.Portable\TiaMcpServer.Portable.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />

    <!--
      Pinned, not wanted directly. ModelContextProtocol 0.3.0-preview.4 asks for
      Microsoft.Bcl.Memory 9.0.5, which carries GHSA-73j8-2gch-69rq (CVSS 7.5, denial of service,
      patched in 9.0.14). A direct reference is how a transitive version is raised. Delete this
      line once the MCP SDK is upgraded and stops asking for a vulnerable one.
    -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
    <PackageReference Include="ModelContextProtocol" Version="0.3.0-preview.4" />
    <PackageReference Include="Siemens.Collaboration.Net.OperatingSystem.Windows" Version="3.0.1725521661" />
    <PackageReference Include="Siemens.Collaboration.Net.TiaPortal.Openness.Resolver" Version="1.1.1725480302" />
    <PackageReference Include="Siemens.Collaboration.Net.TiaPortal.Packages.Openness" Version="20.0.1744190253" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resolved from the targeting pack. Upstream pinned an absolute HintPath into
         "C:\Program Files (x86)\Reference Assemblies\...", which does not exist on every
         machine and breaks the no-hardcoded-paths rule. -->
    <Reference Include="System.Management" />
  </ItemGroup>

  <!--
    PLCSIM Advanced runtime API.

    Unlike Openness there is no NuGet resolver for it, so the path has to be found. It is not
    hardcoded: set the PlcSimApiPath property or the PLCSIM_API_PATH environment variable to
    point somewhere else. The literal below is only the probe used when neither is set, and it
    is guarded by Exists() so a machine without PLCSIM Advanced still builds — the simulation
    tools then report that the runtime is unavailable instead of failing to compile.
  -->
  <PropertyGroup>
    <PlcSimApiPath Condition="'$(PlcSimApiPath)' == ''">$(PLCSIM_API_PATH)</PlcSimApiPath>
    <PlcSimApiPath Condition="'$(PlcSimApiPath)' == ''">$(ProgramW6432)\Siemens\Automation\PLCSIM_V20\resources\bin\wwwroot\assets\lib\runtime\Siemens.Simatic.Simulation.Runtime.Api.x64.dll</PlcSimApiPath>
    <HasPlcSimApi Condition="Exists('$(PlcSimApiPath)')">true</HasPlcSimApi>
  </PropertyGroup>

  <ItemGroup Condition="'$(HasPlcSimApi)' == 'true'">
    <Reference Include="Siemens.Simatic.Simulation.Runtime.Api.x64">
      <HintPath>$(PlcSimApiPath)</HintPath>
      <!-- Copied next to the output: the API lives in an install directory that is not on any
           probing path, so without this it compiles and then fails to load at run time. -->
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup Condition="'$(HasPlcSimApi)' == 'true'">
    <DefineConstants>$(DefineConstants);PLCSIM_AVAILABLE</DefineConstants>
  </PropertyGroup>

  <!--
    Workshop Mode — layer 0 of the safety design.

    Commanding physical hardware is compiled out unless WorkshopMode is set, and it is NOT set
    here on purpose. The binary built for everyday work does not contain the capability at all,
    so no configuration mistake, forgotten flag or stale environment variable can reach a machine
    with it. ModeGate.ForWorkshop refuses outright in this build, and Test16Governance asserts
    that it does.

    Turning this on is not a build option to be flipped when convenient. docs/ROADMAP.md sets the
    five measured conditions that have to hold first, the last of which is an in-person design
    review. Build it with:

        dotnet build -p:WorkshopMode=true

    and only ever with a teacher or workshop supervisor present and the emergency stop in reach.
  -->
  <PropertyGroup Condition="'$(WorkshopMode)' == 'true'">
    <DefineConstants>$(DefineConstants);WORKSHOP_MODE</DefineConstants>
  </PropertyGroup>
</Project>
