{
  "name": "tia-station-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Runs the generate-compile-fix loop against the TIA MCP server, measures it, and answers the workshop gate.",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test",
    "run": "node --env-file-if-exists=.env src/run.ts",
    "gate": "node src/gateReport.ts",
    "api": "node --env-file-if-exists=.env src/apiServer.ts",
    "knowledge:index": "node src/knowledge/knowledgeIndex.ts",
    "knowledge:lookup": "node src/knowledge/hardwareLookup.ts",
    "knowledge:gate": "node src/knowledge/retrievalReport.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
