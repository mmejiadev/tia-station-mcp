{
  // No emit, ever. Node runs the TypeScript directly by stripping the types, so this file exists to
  // type-check and nothing else — one fewer build step between a change and running it, and no dist/
  // that can be stale. What it costs is the TypeScript features that need a real transform, so:
  // no enums, no namespaces, no decorators, no parameter properties. Union types of string literals
  // do everything an enum would do here.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],

    // Imports name the .ts file they mean, because that is the file Node will load.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,

    // The C# side runs every warning as an error and this side matches it. A harness that measures
    // whether generated code is correct has no business being sloppy about its own.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
