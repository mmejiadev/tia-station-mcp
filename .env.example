# Copy to .env and choose a password. .env is ignored by Git; this file is not, so it holds no secret.

POSTGRES_USER=tia
POSTGRES_PASSWORD=choose-a-password
POSTGRES_DB=tia_platform
POSTGRES_PORT=5433

# The platform reads these. The password must match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://tia:choose-a-password@127.0.0.1:5433/tia_platform
TEST_DATABASE_URL=postgres://tia:choose-a-password@127.0.0.1:5433/tia_platform_test

# Sign-in (platform/src/auth). The secret: 64 random hex characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The URL is where the web is reached; Google and GitHub return to <URL>/api/auth/callback/<provider>.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# From the OAuth apps created in Google Cloud and in GitHub (Developer settings > OAuth Apps).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
