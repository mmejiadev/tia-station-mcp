{
  "name": "tia-station-platform",
  "version": "0.1.0",
  "private": true,
  "description": "The web platform's database: an index of what the MCP server recorded, rebuilt from its files. See docs/WEB-PLATFORM.md.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../.env --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio --host 127.0.0.1",
    "db:migrate": "node --env-file-if-exists=../.env src/db/migrateCli.ts",
    "import": "node --env-file-if-exists=../.env src/import/importCli.ts",
    "serve": "node --env-file-if-exists=../.env src/server/serveCli.ts",
    "pair": "node --env-file-if-exists=../.env src/workspace/pairCli.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
