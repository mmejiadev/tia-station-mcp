<Project>

  <!--
    Properties common to every project in the solution.
    This is where the CLAUDE.md rules stop being recommendations
    and become build errors.
  -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- A warning is an error. No exceptions. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Forces public members to be documented (CS1591 becomes an error) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Openness is x64 only -->
    <PlatformTarget>x64</PlatformTarget>

    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Tests keep TreatWarningsAsErrors but are allowed to skip XML documentation: documenting
    every [TestMethod] is noise. The documentation file itself stays enabled because IDE0005
    (unnecessary using) only runs when it is on.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Test'))">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
